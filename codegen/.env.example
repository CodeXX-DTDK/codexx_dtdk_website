# ── Env file layout ───────────────────────────────────────────────────────────
#
#  .env.local       gitignored — local dev (pnpm dev)
#  .env.preview     gitignored — Vercel Preview scope
#  .env.production  gitignored — Vercel Production scope
#
# Copy this file to .env.local and fill in the blanks.

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx

# ── Upstash Redis (Vercel Marketplace) — for rate limiting ────────────────────
# Provision via: Vercel Dashboard → Storage → Marketplace → Upstash for Redis.
# Both vars are auto-injected into the Vercel deployment after linking; copy
# them locally with `vercel env pull` for dev. If unset, rate limiting fails
# OPEN (allow request) — an outage must not take the site's forms offline.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# == GitHub Releases - DTDK Manager download proxy ==============================
# The /api/download endpoint resolves the latest stable/manager@* GitHub Release
# and 302-redirects the browser to its signed asset URL. The releases repo is
# PRIVATE, so a read-only PAT is required server-side. It is never sent to the
# browser. Same value as the CI `CODEXX_RELEASES_PAT` secret.
#   Fine-grained PAT - Contents: Read-only, scoped to the releases repo.
CODEXX_RELEASES_PAT=
# Releases repo (owner/name). Default if unset: CodeXX-DTDK/codexx_dtdk
CODEXX_RELEASES_REPO=CodeXX-DTDK/codexx_dtdk
# GitHub API base - override only for local mock testing. Default: https://api.github.com
CODEXX_RELEASES_API_BASE=
