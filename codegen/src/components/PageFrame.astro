---
// codegen's PageFrame: delegates layout/CSS/chat/analytics to the shared base
// (@codexx/web/PageFrameBase.astro), supplying codegen's footer link groups.
import PageFrameBase from '@codexx/web/PageFrameBase.astro'
---

<PageFrameBase>
  <slot name="header" slot="header" />
  <slot slot="content" />
  <Fragment slot="footer-links">
    <section class="footer-group">
      <span class="footer-heading">Product</span>
      <a href="/">Docs</a>
      <a href="/pricing">Pricing</a>
      <a href="/activate">Activate</a>
      <a href="/portal">Manage subscription</a>
    </section>
    <section class="footer-group">
      <span class="footer-heading">Resources</span>
      <a href="/llms-full.txt">llms.txt</a>
      <a href="/trust/no-call-home">Trust</a>
    </section>
    <section class="footer-group">
      <span class="footer-heading">Feedback</span>
      <a href="#tally-open=Gxg76p&tally-emoji-text=🐛&tally-emoji-animation=wave">Report a bug</a>
      <a href="#tally-open=1AbdKM&tally-emoji-text=💡&tally-emoji-animation=wave">Suggest an improvement</a>
    </section>
    <section class="footer-group">
      <span class="footer-heading">Legal</span>
      <a href="https://legal.codexx-dtdk.com/privacy">Privacy</a>
      <a href="https://legal.codexx-dtdk.com/terms">Terms</a>
      <a href="https://legal.codexx-dtdk.com/eula">EULA</a>
    </section>
  </Fragment>
</PageFrameBase>
