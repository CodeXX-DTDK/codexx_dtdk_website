---
// docsgen's PageFrame: delegates layout/CSS/chat/analytics to the shared base
// (@codexx/web/PageFrameBase.astro). docsgen is free and docs-only, so the
// footer carries no pricing/activation links.
import PageFrameBase from '@codexx/web/PageFrameBase.astro'

const currentYear = new Date().getFullYear()
---

<PageFrameBase>
  <slot name="header" slot="header" />
  <slot slot="content" />
  <Fragment slot="footer-links">
    © {currentYear} docsgen ·
    <a href="/">Docs</a> ·
    <a href="/getting-started/quick-start/">Quick Start</a> ·
    <a href="/llms-full.txt">llms.txt</a> ·
    <a href="/trust/local-first/">Trust</a>
  </Fragment>
</PageFrameBase>
